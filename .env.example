# Eco-Retail Platform — Environment Configuration
# Copy this file to .env and update values for your environment

# Database
DB_TYPE=sqlite
# DB_TYPE=postgresql
DB_HOST=localhost
DB_PORT=5432
DB_NAME=retail
DB_USER=your_username
DB_PASSWORD=your_password

# SQLite (used when DB_TYPE=sqlite)
SQLITE_PATH=data/eco_retail.db

# Application
APP_ENV=development
LOG_LEVEL=INFO

# API
API_HOST=0.0.0.0
API_PORT=8000
